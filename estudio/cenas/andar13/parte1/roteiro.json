  {
   "secao": 8,
   "ofs": 0.3,
   "texto": "A letra era dele. Mas ele nunca tinha escrito aquilo."
  },
  {
   "secao": 9,
   "ofs": 0.1,
   "texto": "Então, alguém bateu na porta.",
   "ate": 1.9
  },
  {
   "secao": 10,
